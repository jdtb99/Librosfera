# ── App ──────────────────────────────────────────────
NODE_ENV=development
ENABLE_CRON_JOBS=true
DEBUG=true
PORT=5000

# ── Database ─────────────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority

# ── Auth ─────────────────────────────────────────────
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRE=30d

# ── Email (SMTP, e.g. Gmail App Password) ────────────
EMAIL_USER=your-address@gmail.com
EMAIL_PASSWORD=your-app-password

# ── URLs ─────────────────────────────────────────────
# In local dev: FRONT_URL=http://localhost:3000  BASE_URL=http://localhost:5000
# In production: point these to your public domain / CloudFront URL
FRONT_URL=http://localhost:3000
BASE_URL=http://localhost:5000

# ── AWS S3 (book image uploads) ──────────────────────
AWS_REGION=us-east-1
# In production (EC2), credentials come from the instance's IAM role
# (see infra/iam.tf) -- leave these two unset there.
# For local dev, set them only if you don't already have an AWS CLI
# profile configured (aws configure) with S3 access.
AWS_ACCESS_KEY_ID=your-iam-access-key-id
AWS_SECRET_ACCESS_KEY=your-iam-secret-access-key
AWS_S3_UPLOADS_BUCKET=your-uploads-bucket-name

# ── CDN ──────────────────────────────────────────────
# CloudFront base URL used to build public image URLs (no trailing slash).
# Leave empty to fall back to direct S3 URLs.
CLOUDFRONT_URL=https://your-distribution.cloudfront.net
